DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
STT_MODEL=medium
STT_DEVICE=cpu
STT_COMPUTE=
PIPER_VOICE=en_US-lessac-medium
PORT=8765
# Host to bind (default 127.0.0.1). Set to 0.0.0.0 only if you intend LAN access.
HOST=127.0.0.1
# Comma-separated allowed Host names (DNS-rebinding guard + same-origin).
ALLOWED_HOSTS=127.0.0.1,localhost
# Optional HTTPS: set both to serve over TLS.
SSL_CERTFILE=
SSL_KEYFILE=
